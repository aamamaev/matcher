# Необязательный путь к Chrome. Если пусто, берётся Chrome for Testing из кэша Playwright или Google Chrome.
CHROME_PATH=

PORT=8787
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tnved_eaeu

# Локальная модель. Префиксы query:/passage: добавляет код.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBED_BATCH=24

# Необязательный переранжировщик. Любой OpenAI-совместимый endpoint,
# в том числе Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1 и LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
